# Phoenix Creator Studio — environment reference
# Copy to .env.local for local development. Never commit real credentials.

# Application environment: development | test | staging | production
APP_ENV=development
NODE_ENV=development
NEXTAUTH_URL=http://localhost:3000
# Development may use a local value. Staging/production require a unique secret of at least 32 characters.
NEXTAUTH_SECRET=

# Runtime PostgreSQL connection. Use a serverless-compatible pooler in production.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/phoenix_creator_studio
# Migration-safe direct connection. Required by deployment validation and migration jobs.
DATABASE_MIGRATION_URL=postgresql://postgres:postgres@localhost:5432/phoenix_creator_studio

# Asset storage: local is development-only. Use supabase or s3 in staging/production.
STORAGE_PROVIDER=local
STORAGE_PATH=storage/uploads
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=

# Rate limiting: memory is development-only. Use redis or upstash in staging/production.
RATE_LIMIT_PROVIDER=memory
RATE_LIMIT_URL=
RATE_LIMIT_TOKEN=

# Server logging
LOG_LEVEL=debug

# AI generation. Optional; mock output remains available when unset.
OPENAI_API_KEY=

# Rainstorms integration. Optional.
RAINSTORMS_BASE_URL=

# Isolated integration testing only. The server accepts x-test-session-user-id only when BOTH are set.
# Never enable this in development, preview, staging, or production.
# APP_ENV=test
# ENABLE_TEST_AUTH_BYPASS=true
# TEST_BASE_URL=http://localhost:3000
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/phoenix_creator_studio_test
# ALLOW_REMOTE_TESTS=false
