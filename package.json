{
  "name": "phoenix-creator-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:smoke": "bash scripts/smoke-test.sh",
    "test:enterprise": "node verify-enterprise-foundation.js",
    "env:check": "node scripts/check-env.mjs",
    "env:check:production": "node scripts/check-env.mjs --production",
    "secrets:check": "node scripts/check-secrets.mjs",
    "dependency:policy": "node scripts/check-dependency-policy.mjs",
    "sbom:generate": "node scripts/generate-sbom.mjs",
    "audit:ci": "npm audit --audit-level=high",
    "supply-chain:check": "npm run dependency:policy && npm run sbom:generate && npm run audit:ci",
    "healthcheck": "bash scripts/healthcheck.sh",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "check": "npm run secrets:check && npm run supply-chain:check && npm run lint && npm run typecheck && npm run test:enterprise && npm run build"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@vercel/analytics": "^1.6.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "next": "16.2.12",
    "next-auth": "^4.24.15",
    "openai": "^6.27.0",
    "postgres": "^3.4.9",
    "puppeteer-core": "^25.1.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "brace-expansion": "2.1.2",
    "js-yaml": "4.3.0",
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  }
}
